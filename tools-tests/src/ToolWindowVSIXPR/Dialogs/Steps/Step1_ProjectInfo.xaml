<UserControl x:Class="ToolWindowVSIXPR.Dialogs.Steps.Step1_ProjectInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             toolkit:Themes.UseVsTheme="True"
             Background="{DynamicResource VsBrush.Window}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Step 1 — Project Information"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource VsBrush.WindowText}"
                   Margin="0,0,0,15"/>

        <!-- Company Name -->
        <TextBlock Grid.Row="1"
                   Text="Company Name"
                   Foreground="{DynamicResource VsBrush.WindowText}"
                   Margin="0,0,0,5"/>
        <TextBox x:Name="CompanyNameTextBox"
                 Grid.Row="2"
                 Padding="8"
                 Margin="0,0,0,15"
                 Background="{DynamicResource VsBrush.CommandBarGradientEnd}"
                 Foreground="{DynamicResource VsBrush.WindowText}"/>

        <!-- Project Name -->
        <TextBlock Grid.Row="3"
                   Text="Project Name *"
                   Foreground="{DynamicResource VsBrush.WindowText}"
                   Margin="0,0,0,5"/>
        <TextBox x:Name="ProjectNameTextBox"
                 Grid.Row="4"
                 Padding="8"
                 Margin="0,0,0,15"
                 Background="{DynamicResource VsBrush.CommandBarGradientEnd}"
                 Foreground="{DynamicResource VsBrush.WindowText}"/>

        <!-- Project Type -->
        <TextBlock Grid.Row="5"
                   Text="Project Type"
                   Foreground="{DynamicResource VsBrush.WindowText}"
                   Margin="0,0,0,5"/>
        <ComboBox x:Name="ProjectTypeComboBox"
                  Grid.Row="6"
                  Padding="8"
                  Margin="0,0,0,15"
                  Background="{DynamicResource VsBrush.CommandBarGradientEnd}"
                  Foreground="{DynamicResource VsBrush.WindowText}"/>
    </Grid>
</UserControl>
