<UserControl x:Class="ToolWindowVSIXPR.Dialogs.WelcomeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:local="clr-namespace:ToolWindowVSIXPR.Dialogs.Steps"
             toolkit:Themes.UseVsTheme="True"
             Background="{DynamicResource VsBrush.Window}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Step Container -->
        <ContentControl Grid.Row="0"
                        x:Name="StepContainer"
                        Margin="0"/>

        <!-- Navigation Footer -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource VsBrush.GrayText}"
                Padding="20"
                Background="{DynamicResource VsBrush.Window}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Step Indicator -->
                <TextBlock Grid.Column="0"
                           x:Name="StepIndicatorTextBlock"
                           Foreground="{DynamicResource VsBrush.WindowText}"
                           VerticalAlignment="Center"/>

                <!-- Spacer -->
                <Border Grid.Column="1"/>

                <!-- Previous Button -->
                <Button Grid.Column="2"
                        x:Name="PreviousButton"
                        Content="Previous"
                        Click="OnPreviousClick"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Background="{DynamicResource VsBrush.CommandBarGradientEnd}"
                        Foreground="{DynamicResource VsBrush.WindowText}"/>

                <!-- Next/Validate Button -->
                <Button Grid.Column="3"
                        x:Name="NextButton"
                        Content="Next"
                        Click="OnNextClick"
                        Padding="12,8"
                        Background="{DynamicResource VsBrush.CommandBarGradientEnd}"
                        Foreground="{DynamicResource VsBrush.WindowText}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
