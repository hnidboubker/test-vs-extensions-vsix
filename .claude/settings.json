{
  "github": {
    "enabled": true,
    "repository": "hnidboubker/test-vs-extensions-vsix",
    "token_env": "GITHUB_TOKEN",
    "use_keyring": true,
    "auto_create_issues": true,
    "issue_labels": ["bug", "auto-detected"],
    "issue_assignee": "hnidboubker"
  },
  "security": {
    "store_credentials": "system_keyring",
    "encrypt_logs": true,
    "audit_enabled": true
  },
  "mcp": {
    "github": {
      "enabled": true,
      "type": "github-api-v3"
    }
  }
}
